PMS_IMAGE=ghcr.io/anissaefuddin/pms:0.1.0
PMS_HOST=pms.example.com
PUBLIC_URL=https://pms.example.com
COOKIE_SECURE=true
# Any characters work for the app, but backup.sh sources this file as shell: avoid $ & ; quotes and spaces, or use `openssl rand -hex 24`.
POSTGRES_PASSWORD=replace-with-a-long-random-value
MAX_SEATS=25
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PMS <noreply@example.com>
# Optional: sender for activation and password-reset mail (default = SMTP_FROM) and the Reply-To header.
SMTP_FROM_AUTH=
SMTP_REPLY_TO=
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASSWORD=<Resend API key>
# Two-factor authentication: 32 random bytes as base64 (openssl rand -base64 32). Empty = users cannot turn 2FA on.
# For rotation put the old key in PMS_2FA_KEY_PREVIOUS (see docs/operations/PILOT_RUNBOOK.md). Keep both out of backups and out of git.
PMS_2FA_KEY=
PMS_2FA_KEY_PREVIOUS=
# Key for single sign-on client secrets, same format: openssl rand -base64 32. Empty = a provider that needs a secret cannot be saved. Rotate with PMS_SSO_KEY_PREVIOUS.
PMS_SSO_KEY=
PMS_SSO_KEY_PREVIOUS=
# Key that signs the short sign-in codes (login by one-time code), same format: openssl rand -base64 32. Empty = the admin cannot turn code sign-in on (422) and the code endpoints answer 503. No _PREVIOUS twin: codes live minutes, so a changed key only invalidates codes in flight.
PMS_OTP_KEY=
# Key for connector secrets (tokens of Apps & Integrations connectors), same format: openssl rand -base64 32. Rotate with PMS_CONNECTOR_KEY_PREVIOUS.
PMS_CONNECTOR_KEY=
PMS_CONNECTOR_KEY_PREVIOUS=
# Starter configuration created once when the app starts (comma separated; empty = none). Recorded in seed_runs, so later
# admin edits are kept. project-master = Workspace fields "Contract/PO Number" and "Contract Value" (IDR, visible and
# editable only by the group "Contract Managers"). See docs/operations/r1/MVP-03_PROJECT_MASTER.md.
PMS_SEED=
# Pydio folder links (MVP-04). URL = the https Cells address users open, without credentials or a path. ROOTS = comma-separated
# workspace slug[/folder] a link may point into (required with the URL). Empty URL = off. TOKEN = personal access token of a
# read-only Cells account, used only by the file listing (MVP-13), which this compose file keeps off; leave it empty.
# See docs/operations/r1/MVP-04_13_PYDIO_FOLDER.md.
PMS_PYDIO_LINK_URL=
PMS_PYDIO_LINK_TOKEN=
PMS_PYDIO_LINK_ROOTS=
# Approved folders per Customer, JSON keyed by the Customer code, each inside ROOTS above. A Customer without an entry gets no
# document link. Example: PMS_PYDIO_CUSTOMER_ROOTS='{"ACME":["projects/acme"]}' (keep the single quotes: scripts source this file)
PMS_PYDIO_CUSTOMER_ROOTS=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
# Off-server copy via rclone (installed on this host), e.g. an rclone crypt remote on S3/MinIO/SFTP. Empty = backups stay on this server.
BACKUP_REMOTE=
# Or rsync over SSH (host must be in known_hosts; key via BACKUP_RSYNC_SSH, e.g. "ssh -i /root/.ssh/pms_backup -o BatchMode=yes"). Mirrors the local dir incl. retention.
BACKUP_RSYNC_DEST=
BACKUP_RSYNC_SSH=
BACKUP_RSYNC_MAX_DELETE=20
# Directory read by node_exporter's textfile collector; backup.sh writes pms_backup_last_success_timestamp_seconds there. Empty = no metric.
BACKUP_TEXTFILE_DIR=
BACKUP_ALERT_URL=
TRAEFIK_NETWORK=proxy
